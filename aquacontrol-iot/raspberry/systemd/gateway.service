[Unit]
Description=Gateway Modbus TCP <-> MQTT - planta de agua potable
After=network-online.target plc-simulado.service
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/aquacontrol/raspberry
ExecStart=/home/pi/aquacontrol/raspberry/.venv/bin/python gateway.py --config config.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
