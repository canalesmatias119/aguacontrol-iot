[Unit]
Description=PLC simulado Modbus TCP - planta de agua potable
After=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/aquacontrol/raspberry
ExecStart=/home/pi/aquacontrol/raspberry/.venv/bin/python plc_simulado.py --port 5020
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
