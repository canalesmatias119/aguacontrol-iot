# Copia este archivo a config.env y completa los valores. config.env NO se sube a git.

# --- Broker MQTT (Mosquitto de la plataforma) ---
# Local: IP del PC que corre docker compose. Railway: host:puerto del TCP Proxy de mosquitto.
MQTT_BROKER_HOST=192.168.1.100
MQTT_BROKER_PORT=1883
MQTT_USERNAME=planta
MQTT_PASSWORD=change-me-mqtt-password
MQTT_TOPIC_PREFIX=planta

# --- PLC (Modbus TCP) ---
# PLC simulado en la misma Raspberry Pi: PLC_HOST=127.0.0.1 y PLC_PORT=5020
# Siemens S7-1200 real: su IP (ej. 192.168.0.1) y PLC_PORT=502
PLC_HOST=127.0.0.1
PLC_PORT=5020
PLC_UNIT_ID=1

# --- Dispositivos registrados en la plataforma (Dispositivos -> + Agregar) ---
PLC_DEVICE_SLUG=plc-planta-01
PLC_DEVICE_TOKEN=paste-token-here
RPI_DEVICE_SLUG=rpi-gateway-01
RPI_DEVICE_TOKEN=paste-token-here
# El gateway escucha las lecturas de este ESP32 y se las pasa al PLC
ESP32_DEVICE_SLUG=esp32-calidad-01

# --- Tiempos ---
POLL_SECONDS=2
PUBLISH_SECONDS=5
